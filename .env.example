# ═══════════════════════════════════════════════════════════
#  .env.example — Template variables d'environnement
#  COPIER en .env et remplir avec les vraies valeurs
#  NE JAMAIS committer .env — uniquement .env.example
# ═══════════════════════════════════════════════════════════

# ── NestJS / Node ───────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Générer avec : openssl rand -hex 32
SESSION_SECRET=your-very-long-random-secret-key-here

# ── SMTP — Envoi email formulaire contact ───────────────────
# Gmail : activer "Mots de passe d'application" dans la sécurité du compte
# (NE PAS utiliser le mot de passe principal Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=diamantek.traiteur@gmail.com
SMTP_PASSWORD=your-gmail-app-password-16-chars

# Email qui recevra les demandes de devis
CONTACT_EMAIL=diamantek.traiteur@gmail.com

# Email expéditeur affiché (peut être le même)
FROM_EMAIL=noreply@diamantektraiteur.com
FROM_NAME=Diamante K - Site Web

# ── Rate Limiting ────────────────────────────────────────────
# Requêtes max par minute sur /api/contact par IP
RATE_LIMIT_CONTACT=10

# ── Production (décommenter en prod) ────────────────────────
# NODE_ENV=production
